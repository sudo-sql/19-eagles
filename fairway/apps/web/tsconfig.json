{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve", "noEmit": true, "allowJs": true, "incremental": true,
    "plugins": [{ "name": "next" }], "paths": { "@/*": ["./*"] },
    "lib": ["dom", "dom.iterable", "esnext"], "module": "esnext"
