# ===== Supabase (create project at https://supabase.com/dashboard -> New project) =====
# Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server/edge functions only, never shipped to clients
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ===== Anthropic (AI Caddie; app fully functional without it) =====
# https://console.anthropic.com -> API Keys. Used ONLY in supabase/functions/ai-caddie
ANTHROPIC_API_KEY=

# ===== RevenueCat (mobile subscriptions) https://app.revenuecat.com =====
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# ===== Stripe (web subscriptions) https://dashboard.stripe.com/apikeys =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ANNUAL=   # price id for $39.99/yr
STRIPE_PRICE_MONTHLY=  # price id for $4.99/mo

# ===== Sentry https://sentry.io =====
SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ===== Course data provider (optional; OSM fallback + seed courses work without it) =====
COURSE_API_PROVIDER=none   # none | golfcourseapi
COURSE_API_KEY=

# ===== Map tiles (satellite imagery; MapLibre-compatible raster tiles) =====
EXPO_PUBLIC_TILE_URL_TEMPLATE=
NEXT_PUBLIC_TILE_URL_TEMPLATE=
